# Example environment for deploy/knowledge/docker-compose.minio.yml.
# Copy to minio.env (gitignored by location convention — never commit real
# credentials) and adjust before `docker compose up`.
BIND_HOST=127.0.0.1
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me-before-production-use
MINIO_REGION=us-east-1
MINIO_BUCKET=quantflow-evidence
