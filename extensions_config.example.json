{
  "middlewares": [],
  "mcpInterceptors": [
    "my_package.mcp.auth:build_auth_interceptor"
  ],
  "mcpServers": {
    "github": {
      "enabled": false,
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-github"
      ],
      "env": {
        "GITHUB_TOKEN": "$GITHUB_TOKEN"
      },
      "tool_name_prefix": true,
      "session_init_timeout": 60,
      "tool_call_timeout": 60,
      "description": "GitHub MCP server for repository operations"
    },
    "parallel-search": {
      "enabled": false,
      "type": "http",
      "url": "https://search.parallel.ai/mcp",
      "headers": {
        "User-Agent": "deer-flow"
      },
      "description": "Optional anonymous Parallel Search tools for web search and fetching requested URLs"
    },
    "openviking": {
      "enabled": false,
      "type": "http",
      "url": "http://127.0.0.1:1933/mcp",
      "headers": {
        "X-API-Key": "$OPENVIKING_API_KEY"
      },
      "description": "Official OpenViking tools for explicit memory and resource operations"
    },
    "postgres": {
      "enabled": false,
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-postgres",
        "postgresql://localhost/mydb"
      ],
      "env": {},
      "description": "PostgreSQL database access",
      "routing": {
        "mode": "prefer",
        "priority": 50,
        "keywords": [
          "database",
          "SQL",
          "table",
          "订单",
          "用户"
        ]
      },
      "tools": {
        "query": {
          "routing": {
            "mode": "prefer",
            "priority": 100,
            "keywords": [
              "查库",
              "订单表",
              "指标"
            ]
          }
        }
      }
    },
    "alpha_engine": {
      "enabled": false,
      "type": "stdio",
      "command": "/path/to/alpha-engine-env/bin/python",
      "args": ["-m", "alpha_engine.mcp_server"],
      "env": {
        "PYTHONPATH": "/path/to/alpha_engine/src"
      },
      "tool_name_prefix": true,
      "session_init_timeout": 120,
      "tool_call_timeout": 600,
      "description": "Local quant toolkit: S&P500 price history, LSE vendor candles/yields/fundamentals, factor analysis (FF/AQR/JKP), walk-forward ML signal scores, momentum backtests + GPU param sweeps, spark-mcp §15.2 backtest/causality/risk tools, portfolio optimization (max-sharpe/HRP/black-litterman), Brinson attribution, factor risk decomposition, themed chart PNGs, HTML tearsheets"
    },
    "kizonlp": {
      "enabled": false,
      "type": "stdio",
      "command": "/path/to/alpha-engine-env/bin/python",
      "args": ["-m", "kizoNLP.mcp_server"],
      "env": {
        "PYTHONPATH": "/path/to/kizoNLP-parent"
      },
      "tool_name_prefix": true,
      "session_init_timeout": 120,
      "tool_call_timeout": 600,
      "description": "Financial NLP: transformer sentiment scoring, zero-shot classification, abstractive summarization, keyphrase extraction, PDF text extraction"
    },
    "reportforge": {
      "enabled": false,
      "type": "stdio",
      "command": "/path/to/report-forge/.venv/bin/python",
      "args": ["-m", "reportforge.mcp_server"],
      "env": {
        "PYTHONPATH": "/path/to/alpha_engine/src"
      },
      "tool_name_prefix": false,
      "session_init_timeout": 60,
      "tool_call_timeout": 900,
      "description": "Multi-format reports (HTML/PDF-via-Typst/pdf-web/DOCX) on Quarto: scaffold, host-side code execution, asset ingestion, render, inspection, chart export"
    },
    "long-running-reports": {
      "enabled": false,
      "type": "http",
      "url": "https://reports.example.com/mcp",
      "description": "Example ordinary MCP background-task contract",
      "session_init_timeout": 60,
      "tool_call_timeout": 60,
      "task_toolsets": [
        {
          "name": "report-generation",
          "submit_tool": "submit_report",
          "status_tool": "get_report_status",
          "cancel_tool": "cancel_report"
        }
      ]
    }
  },
  "skills": {}
}
